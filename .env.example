# Copy to .env and fill in. Never commit real keys (.env is gitignored).
DIPPER_CORS=http://localhost:3000
# Photo analysis. Provider: anthropic | gemini. If unset: Claude when ANTHROPIC_API_KEY is set, else Gemini when
# GEMINI_API_KEY or LLM_API_KEY is set. Without any key, reports are still recorded and photos are kept unanalysed.
DIPPER_VISION_PROVIDER=
ANTHROPIC_API_KEY=
LLM_API_KEY=
# DIPPER_VISION_MODEL=claude-opus-5
# DIPPER_GEMINI_MODEL=gemini-flash-latest
DATABASE_URL=postgresql://dipper:dipper@localhost:5432/dipper
FHIR_BASE_URL=http://localhost:8080/fhir
