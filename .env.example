# Copy to .env and fill in. Never commit real keys (.env is gitignored).
# Demo mode: scenario replay and one-click demo sign-in. Set 0 in production and create staff with
#   python -m dipper_api.admin create-user --name "..." --role inspector
DIPPER_DEMO=1
# Photo analysis. Provider: anthropic | gemini. If unset: Claude when ANTHROPIC_API_KEY is set, else Gemini when
# GEMINI_API_KEY is set (LLM_API_KEY is used only with DIPPER_VISION_PROVIDER=gemini). Without a key, reports are
# still recorded and photos are not analysed.
DIPPER_VISION_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# DIPPER_VISION_MODEL=claude-opus-5
# DIPPER_GEMINI_MODEL=gemini-flash-latest
# FHIR server for case hand-off (docker compose --profile fhir starts one at http://hapi:8080/fhir)
FHIR_BASE_URL=
# FHIR_TOKEN=
# Storage (defaults shown for Docker). The event store is SQLite in WAL mode.
# DIPPER_DB=/app/state/dipper.sqlite3
# DIPPER_MEDIA=/app/state/media
# DIPPER_MEDIA_DAYS=30
# Behind a reverse proxy, the number of proxies, so rate limits see the real client:
# DIPPER_PROXY_HOPS=1
